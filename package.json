{
  "name": "smart-json-editor",
  "displayName": "Smart JSON Editor",
  "description": "A smart JSON viewer, editor, and exporter. View and edit JSON files in an interactive table or grid. Sort, filter, and export to CSV.",
  "version": "1.0.5",
  "publisher": "lal",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shyam-lal/json-table-viewer.git"
  },
  "homepage": "https://github.com/shyam-lal/json-table-viewer/blob/main/README.md",
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "json",
    "table",
    "grid",
    "editor",
    "viewer",
    "edit",
    "view",
    "preview",
    "sheet",
    "excel",
    "xlsx",
    "csv",
    "export",
    "sort",
    "filter",
    "data",
    "smart",
    "workbench"
  ],
  "activationEvents": [
    "onLanguage:json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "json-table-viewer.showPreview",
        "title": "Preview JSON as Table",
        "icon": "$(table)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == json",
          "command": "json-table-viewer.showPreview",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "resourceLangId == json",
          "command": "json-table-viewer.showPreview",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile:ts": "tsc -p ./",
    "compile:assets": "cpx \"src/webview/**\" out/webview",
    "compile": "npm-run-all compile:ts compile:assets",
    "watch:ts": "tsc -watch -p ./",
    "watch:assets": "cpx \"src/webview/**\" out/webview --watch",
    "watch": "npm-run-all --parallel watch:ts watch:assets",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.3",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.83.0",
    "@types/xlsx": "^0.0.35",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "@vscode/test-electron": "^2.3.6",
    "cpx": "^1.5.0",
    "eslint": "^8.52.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}